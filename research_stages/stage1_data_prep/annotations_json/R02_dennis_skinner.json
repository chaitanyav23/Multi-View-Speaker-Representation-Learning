      "end": 113.0,
      "end_clipped_to_audio": 113.0,
      "duration": 18.0,
      "words": 21,
      "text": "I think he knows the word beginning with D and ending in Y that he inappropriately used. Dave. Dave. Dave. Withdraw.",
